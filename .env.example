# --------------------------------------------------
# OpenAI
# --------------------------------------------------

# Required for image generation.
# Create a service/project API key and keep the real value out of Git.
OPENAI_API_KEY=sk-svcacct-xxxxxx


# --------------------------------------------------
# Database
# --------------------------------------------------

# Legacy/local Docker MariaDB credentials.
IG_DB_PASSWORD=pwd
IG_DB_ROOT_PASSWORD=pSwd

# SQLAlchemy database connection string.
#
# Local Docker example:
DATABASE_URL=mysql+pymysql://ig:pwd@ig-db:3306/ig
#
# Cloud PostgreSQL / Neon example:
# DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require


# --------------------------------------------------
# Job Queue
# --------------------------------------------------

# Queue backend used by the application.
#
# Supported values:
#
#   vercel
#       Vercel Queue.
#       Recommended for normal Vercel deployments.
#       Does NOT require Redis or a separate RQ worker.
#
#   rq
#       Python RQ backed by Redis.
#       Requires BOTH:
#         1. a Redis / Redis-compatible service
#         2. a separately hosted long-running RQ worker
#
# Recommended Vercel deployment default:
JOB_QUEUE_PROVIDER=vercel


# --------------------------------------------------
# Redis / RQ — OPTIONAL
# --------------------------------------------------

# These settings are NOT required when:
#
#   JOB_QUEUE_PROVIDER=vercel
#
# Configure REDIS_URL only when using:
#
#   JOB_QUEUE_PROVIDER=rq
#
# Redis may be provided by a managed service such as:
#
#   Upstash Redis
#   Redis Cloud
#   another Redis-compatible provider
#   self-hosted Redis
#
# The RQ worker must also run separately on infrastructure capable
# of hosting a persistent Python process, for example:
#
#   background-worker platform
#   container host
#   virtual machine / VPS
#   Kubernetes
#   self-hosted machine
#
# Local Docker example:
#
# REDIS_URL=redis://ig-redis:6379/0
#
# External managed Redis example:
#
# REDIS_URL=rediss://default:password@redis-provider.example.com:6379

# --------------------------------------------------
# Vercel Queue
# --------------------------------------------------

# Vercel Queue is the recommended queue backend for normal
# IG deployments on Vercel.
#
# Production Vercel deployments do not require REDIS_URL or
# a separately hosted RQ worker.
#
# IG_QUEUE_BASE_URL is only required when running the standalone
# Vercel Queue development server locally.
#
# Local development example:
#
IG_QUEUE_BASE_URL=http://127.0.0.1:4790
#
# Vercel runtime values such as VERCEL_OIDC_TOKEN and VERCEL_REGION
# are normally supplied by Vercel and should not be committed here.

# --------------------------------------------------
# Artifact Storage
# --------------------------------------------------

# Artifact storage backend.
#
# Supported values:
#   local   -> local filesystem
#   vercel  -> Vercel Blob
#
# Local development default:
# ARTIFACT_STORE_PROVIDER=local
#
# Cloud deployment default:
ARTIFACT_STORE_PROVIDER=vercel


# --------------------------------------------------
# Logging / Tracing
# --------------------------------------------------

# Standard Python application log level.
# Common values: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enables additional queue/job lifecycle tracing.
# Useful when debugging enqueue / worker execution paths.
IG_TRACE_JOBS=false

# --------------------------------------------------
# Authentication
# --------------------------------------------------

# Controls whether users may create their own accounts.
#
# false -> registration endpoint returns 403
# true  -> self-registration is allowed
#
# Recommended default for deployed environments:
ALLOW_SELF_REGISTRATION=false
