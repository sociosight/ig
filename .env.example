# --------------------------------------------------
# OpenAI
# --------------------------------------------------

# Required for image generation.
# Create a service/project API key and keep the real value out of Git.
OPENAI_API_KEY=sk-svcacct-xxxxxx


# --------------------------------------------------
# Database
# --------------------------------------------------

# Legacy/local Docker MariaDB credentials.
IG_DB_PASSWORD=pwd
IG_DB_ROOT_PASSWORD=pSwd

# SQLAlchemy database connection string.
#
# Local Docker example:
DATABASE_URL=mysql+pymysql://ig:pwd@ig-db:3306/ig
#
# Cloud PostgreSQL / Neon example:
# DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require


# --------------------------------------------------
# Job Queue
# --------------------------------------------------

# Queue backend used by the application.
#
# Supported values:
#   rq      -> RQ backed by Redis
#   vercel  -> Vercel Queue
#
# Recommended default:
JOB_QUEUE_PROVIDER=rq


# --------------------------------------------------
# Redis / RQ
# --------------------------------------------------

# Required when JOB_QUEUE_PROVIDER=rq.
#
# Local Docker example:
REDIS_URL=redis://ig-redis:6379/0
#
# External managed Redis example:
# REDIS_URL=rediss://default:password@redis-provider.example.com:6379


# --------------------------------------------------
# Artifact Storage
# --------------------------------------------------

# Artifact storage backend.
#
# Supported values:
#   local   -> local filesystem
#   vercel  -> Vercel Blob
#
# Local development default:
ARTIFACT_STORE_PROVIDER=local
#
# Cloud example:
# ARTIFACT_STORE_PROVIDER=vercel


# --------------------------------------------------
# Logging / Tracing
# --------------------------------------------------

# Standard Python application log level.
# Common values: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enables additional queue/job lifecycle tracing.
# Useful when debugging enqueue / worker execution paths.
IG_TRACE_JOBS=false


# --------------------------------------------------
# Vercel Queue
# --------------------------------------------------

# Only required when JOB_QUEUE_PROVIDER=vercel
# and using the standalone/local Vercel Queue development setup.
#
# IG_QUEUE_BASE_URL=http://127.0.0.1:4790
#
# Vercel runtime values such as VERCEL_OIDC_TOKEN and VERCEL_REGION
# are normally provided by Vercel and should not be committed here.
